        async function openChat(cid,type){activeChatId=cid;activeChatType=type;const cs=await db.ref('chats/'+cid).once('value'),chat=cs.val();if(!db.cache.chats)db.cache.chats={};db.cache.chats[cid]=chat;if(chat.lockPass&&chat.lockPass!==userSettings.lockPass){alert('Чат защищён паролем!');return;}
