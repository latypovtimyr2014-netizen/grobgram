        function setAccent(c){applyAccent(c);document.querySelectorAll('.theme-dot').forEach(d=>d.classList.remove('active'));document.querySelector(`.theme-dot[data-color="${c}"]`).classList.add('active');}
        document.getElementById('toggleThemeBtn').addEventListener('click',()=>{toggleThemeClass();userSettings.theme=isLightTheme?'light':'dark';});
        document.getElementById('saveSettingsBtn').addEventListener('click',async()=>{const nn=document.getElementById('settingsNick').value.trim(),np=document.getElementById('settingsPass').value.trim();if(!nn)return;if(nn!==myNick){const s=await db.ref('users').orderByChild('nick').equalTo(nn).once('value');if(s.exists()){alert('Ник занят!');return;}}userSettings.bio=document.getElementById('settingsBio').value.trim();userSettings.link=document.getElementById('settingsLink').value.trim();userSettings.birthday=document.getElementById('settingsBday').value;userSettings.signature=document.getElementById('settingsSignature').value.trim();userSettings.nickColor=document.getElementById('settingsNickColor').value.trim();userSettings.status=document.getElementById('settingsStatus').value.trim();userSettings.fontSize=parseInt(document.getElementById('fontSizeSelect').value);userSettings.bubbleStyle=document.getElementById('bubbleStyleSelect').value;userSettings.fontFamily=document.getElementById('fontFamilySelect').value;userSettings.privacyWrite=document.getElementById('privacyWriteSelect').value;userSettings.privacyOnline=document.getElementById('privacyOnlineSelect').value;userSettings.privacyAvatar=document.getElementById('privacyAvatarSelect').value;userSettings.autoDelete=document.getElementById('autoDeleteSelect').value;userSettings.dnd=document.getElementById('dndSelect').value;userSettings.invisible=document.getElementById('invisibleSelect').value;userSettings.quickReplies=document.getElementById('quickReplies').value;userSettings.language=document.getElementById('languageSelect').value;userSettings.timeFormat=document.getElementById('timeFormatSelect').value;userSettings.notifyOnline=document.getElementById('notifyOnlineSelect').value;userSettings.autoReply=document.getElementById('autoReply').value;const up={nick:nn,settings:userSettings};if(np)up.pass=np;await db.ref('users/'+myId).update(up);myNick=nn;localStorage.setItem('gb_nick',myNick);updateFooterAvatar();document.getElementById('footerName').textContent=myNick;closeModal('settingsModal');applyAllSettings();loadChats();});
        document.getElementById('exportDataBtn').addEventListener('click',async()=>{const s=await db.ref('users/'+myId).once('value');const data=JSON.stringify(s.val()||{},null,2);const blob=new Blob([data],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='grobgram_backup.json';a.click();});
        document.getElementById('exportPdfBtn').addEventListener('click',()=>{alert('PDF: нажмите Ctrl+P');});
        document.getElementById('clearCacheBtn').addEventListener('click',()=>{localStorage.clear();alert('Кеш очищен!');});
        document.getElementById('clearAllChatsBtn').addEventListener('click',async()=>{if(!confirm('Очистить ВСЕ чаты?'))return;const s=await db.ref('chats').once('value');const chats=s.val()||{};for(const id in chats){if(chats[id].participants.includes(myId)){await db.ref('messages/'+id).remove();}}alert('Все чаты очищены!');loadChats();});
        document.getElementById('deleteAccountBtn').addEventListener('click',async()=>{if(!confirm('Удалить аккаунт?'))return;await db.ref('users/'+myId).remove();logout();});
        document.getElementById('logoutBtn').addEventListener('click',logout);
        function logout(){updateOnline(false);localStorage.clear();myId=null;myNick=null;activeChatId=null;document.getElementById('emptyState').style.display='flex';document.getElementById('activeChat').style.display='none';document.getElementById('chatList').innerHTML='';db.ref('messages').off();db.ref('calls').off();showAuth();}
        document.getElementById('copyId').addEventListener('click',()=>navigator.clipboard.writeText(myId));

        // ЗВОНКИ
        function listenForCalls(){db.ref('calls').on('child_added',async(snap)=>{const call=snap.val();if(call.to===myId&&call.status==='ringing'){currentCallId=snap.key;isCaller=false;callType=call.type;document.getElementById('callStatus').textContent=`📞 Входящий ${call.type==='video'?'видео':'аудио'} от ${call.fromNick}...`;document.getElementById('callWindow').style.display='block';document.getElementById('acceptCallBtn').style.display='inline-block';document.getElementById('rejectCallBtn').style.display='inline-block';document.getElementById('endCallBtn').style.display='none';}});db.ref('calls').on('child_changed',async(snap)=>{const call=snap.val();if(call.status==='accepted'&&isCaller&&snap.key===currentCallId){document.getElementById('callStatus').textContent='✅ Соединяем...';await createPeerConnection(snap.key);}if(call.status==='rejected'&&isCaller&&snap.key===currentCallId){document.getElementById('callWindow').style.display='none';alert('Звонок отклонён');cleanupCall();}});db.ref('calls').on('child_removed',(snap)=>{if(snap.key===currentCallId){document.getElementById('callWindow').style.display='none';cleanupCall();}});}
        async function startCall(type){if(!activeChatId||activeChatType!=='chat')return;const cs=await db.ref('chats/'+activeChatId).once('value'),chat=cs.val();const fid=chat.participants.find(p=>p!==myId);const u=db.cache?.users?.[fid]||{};isCaller=true;callType=type;currentCallId=generateId();await db.ref('calls/'+currentCallId).set({from:myId,fromNick:myNick,to:fid,type:type,status:'ringing',time:Date.now()});document.getElementById('callStatus').textContent=`📞 Звоним ${u.nick}...`;document.getElementById('callWindow').style.display='block';document.getElementById('acceptCallBtn').style.display='none';document.getElementById('rejectCallBtn').style.display='none';document.getElementById('endCallBtn').style.display='inline-block';if(type==='video'){document.getElementById('localVideo').style.display='block';document.getElementById('remoteVideo').style.display='block';}}
        async function acceptCall(){document.getElementById('acceptCallBtn').style.display='none';document.getElementById('rejectCallBtn').style.display='none';document.getElementById('endCallBtn').style.display='inline-block';document.getElementById('callStatus').textContent='🔗 Соединяем...';await db.ref('calls/'+currentCallId).update({status:'accepted'});await createPeerConnection(currentCallId);if(callType==='video'){document.getElementById('localVideo').style.display='block';document.getElementById('remoteVideo').style.display='block';}}
        async function rejectCall(){await db.ref('calls/'+currentCallId).update({status:'rejected'});document.getElementById('callWindow').style.display='none';cleanupCall();}
        async function endCall(){if(currentCallId)await db.ref('calls/'+currentCallId).remove();document.getElementById('callWindow').style.display='none';cleanupCall();}
        async function createPeerConnection(callId){try{localStream=await navigator.mediaDevices.getUserMedia({audio:true,video:callType==='video'});if(callType==='video')document.getElementById('localVideo').srcObject=localStream;peerConnection=new RTCPeerConnection(servers);localStream.getTracks().forEach(track=>peerConnection.addTrack(track,localStream));peerConnection.ontrack=(event)=>{if(callType==='video')document.getElementById('remoteVideo').srcObject=event.streams[0];else{const audio=new Audio();audio.srcObject=event.streams[0];audio.play();}};peerConnection.onicecandidate=(event)=>{if(event.candidate)db.ref('calls/'+callId+'/iceCandidates').push(event.candidate);};if(isCaller){const offer=await peerConnection.createOffer();await peerConnection.setLocalDescription(offer);await db.ref('calls/'+callId+'/offer').set({type:offer.type,sdp:offer.sdp});}if(!isCaller){db.ref('calls/'+callId+'/offer').on('value',async(snap)=>{const offer=snap.val();if(offer&&!peerConnection.currentRemoteDescription){await peerConnection.setRemoteDescription(new RTCSessionDescription(offer));const answer=await peerConnection.createAnswer();await peerConnection.setLocalDescription(answer);await db.ref('calls/'+callId+'/answer').set({type:answer.type,sdp:answer.sdp});}});}if(isCaller){db.ref('calls/'+callId+'/answer').on('value',async(snap)=>{const answer=snap.val();if(answer&&!peerConnection.currentRemoteDescription)await peerConnection.setRemoteDescription(new RTCSessionDescription(answer));});}db.ref('calls/'+callId+'/iceCandidates').on('child_added',async(snap)=>{const candidate=snap.val();if(candidate&&peerConnection)await peerConnection.addIceCandidate(new RTCIceCandidate(candidate));});document.getElementById('callStatus').textContent='✅ Разговор...';}catch(err){console.error(err);alert('Не удалось начать звонок.');endCall();}}
        function cleanupCall(){if(localStream){localStream.getTracks().forEach(t=>t.stop());localStream=null;}if(peerConnection){peerConnection.close();peerConnection=null;}document.getElementById('localVideo').srcObject=null;document.getElementById('remoteVideo').srcObject=null;document.getElementById('localVideo').style.display='none';document.getElementById('remoteVideo').style.display='none';currentCallId=null;}

        // ЗАПУСК
        init();
    </script>
</body>
</html>
