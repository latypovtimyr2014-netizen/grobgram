    <script>
        const firebaseConfig = { apiKey: "AIzaSyD_dKMWTmk_QqfSB6PyDVTZenyfQ0ecwGw", authDomain: "grobgram.firebaseapp.com", databaseURL: "https://grobgram-default-rtdb.europe-west1.firebasedatabase.app", projectId: "grobgram", storageBucket: "grobgram.firebasestorage.app", messagingSenderId: "203780399351", appId: "1:203780399351:web:649bbf4cff9947c5e1f3f2" };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        const ADMIN_ID = 'u_1778707098521';
        const servers = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };
        const ALL_STICKERS = ['🌟','💎','🔥','👑','🎯','🚀','💜','🍀','🎵','🌈','🦄','🎪'];

        let myId=null,myNick=null,activeChatId=null,activeChatType='chat',currentTab='chats',editingMsgId=null,forwardMsgId=null,isLightTheme=false,replyToMsg=null;
        let userSettings={fontSize:14,avatar:'',theme:'dark',bio:'',link:'',accent:'#7c3aed',wallpaper:'',bubbleStyle:'round',privacyWrite:'all',privacyOnline:'all',privacyAvatar:'all',autoDelete:'never',dnd:'off',sound:'',birthday:'',lockPass:'',signature:'',profileMusic:'',stickers:{},nickColor:'',status:'',invisible:'off',quickReplies:'',language:'ru',timeFormat:'24',fontFamily:'default',notifyOnline:'off',autoReply:''};
        let mediaRecorder=null,audioChunks=[],recordingStartTime=0,recordingTimerInterval=null,soundAudio=null;
        let localStream=null,peerConnection=null,currentCallId=null,isCaller=false,callType='audio';
        let notifiedOnlineUsers={};

        function esc(t){const d=document.createElement('div');d.textContent=t;return d.innerHTML;}
        function tfmt(ts){return new Date(ts).toLocaleTimeString('ru',{hour:'2-digit',minute:'2-digit',hour12:userSettings.timeFormat==='12'});}
        function timeAgo(ts){const diff=Date.now()-ts;if(diff<60000)return'только что';if(diff<3600000)return Math.floor(diff/60000)+' мин';if(diff<86400000)return Math.floor(diff/3600000)+' ч';return new Date(ts).toLocaleDateString('ru');}
        function generateId(){return'u_'+Date.now()+'_'+Math.random().toString(36).substr(2,6);}
        function showModal(id){document.getElementById(id).classList.add('active');}
        function closeModal(id){document.getElementById(id).classList.remove('active');}
        function applyAccent(c){document.documentElement.style.setProperty('--accent',c);document.documentElement.style.setProperty('--bubble-mine',c);userSettings.accent=c;}
        function isAdmin(){return myId===ADMIN_ID;}

        // ИСПРАВЛЕННАЯ ИНИЦИАЛИЗАЦИЯ
        function init(){
            const si=localStorage.getItem('gb_id'),sn=localStorage.getItem('gb_nick');
            if(si&&sn){
                db.ref('users/'+si).once('value').then(s=>{
                    if(s.exists()){
                        myId=si;myNick=sn;
                        loadSettings();
                        updateOnline(true);
                        showApp();
                        listenForCalls();
                        monitorOnlineUsers();
                    }else{
                        localStorage.clear();
                        showAuth();
                    }
                }).catch(()=>{
                    showAuth();
                });
            }else{
                showAuth();
            }
            window.addEventListener('beforeunload',()=>updateOnline(false));
        }

        function showAuth(){
            document.getElementById('authModal').classList.add('active');
            document.getElementById('authNick').value='';
            document.getElementById('authPass').value='';
            document.getElementById('authErr').textContent='';
        }

        function loadSettings(){db.ref('users/'+myId+'/settings').once('value').then(s=>{if(s.exists()){userSettings={...userSettings,...s.val()};applyAllSettings();}});}
        function applyAllSettings(){document.documentElement.style.setProperty('--message-font-size',userSettings.fontSize+'px');if(userSettings.theme==='light'&&!isLightTheme)toggleThemeClass();if(userSettings.theme==='dark'&&isLightTheme)toggleThemeClass();applyAccent(userSettings.accent||'#7c3aed');if(userSettings.wallpaper){const mc=document.getElementById('messagesContainer');if(mc){mc.style.backgroundImage=`url(${userSettings.wallpaper})`;mc.style.backgroundSize='cover';}}if(userSettings.sound){soundAudio=new Audio(userSettings.sound);}document.getElementById('dndBadge').style.display=userSettings.dnd!=='off'?'inline':'none';if(userSettings.fontFamily&&userSettings.fontFamily!=='default'){document.body.style.fontFamily=userSettings.fontFamily==='serif'?'Georgia,serif':'monospace';}if(isAdmin()){document.getElementById('adminBtn').style.display='inline-block';}}
        function toggleThemeClass(){isLightTheme=!isLightTheme;document.body.classList.toggle('light-theme');}
        function updateOnline(s){if(!myId)return;db.ref('users/'+myId+'/online').set(s?true:null);db.ref('users/'+myId+'/lastSeen').set(Date.now());}
        function playSound(){if(userSettings.dnd!=='off')return;if(soundAudio){soundAudio.currentTime=0;soundAudio.play().catch(()=>{});}}

        function monitorOnlineUsers(){db.ref('users').on('value',snap=>{db.cache=db.cache||{};db.cache.users=snap.val()||{};const users=db.cache.users;for(const id in users){if(id===myId)continue;if(users[id].online&&!notifiedOnlineUsers[id]){notifiedOnlineUsers[id]=true;if(userSettings.notifyOnline==='on'){try{new Notification('GrobGram',{body:`${users[id].nick} в сети!`,icon:'💬'});}catch(e){}}}if(!users[id].online){delete notifiedOnlineUsers[id];}}if(activeChatId)renderMessages();loadChats();});}
        if(Notification.permission==='default')Notification.requestPermission();

        // АВТОРИЗАЦИЯ
        document.getElementById('loginBtn').addEventListener('click',async()=>{const n=document.getElementById('authNick').value.trim(),p=document.getElementById('authPass').value.trim(),e=document.getElementById('authErr');if(!n||!p){e.textContent='Заполните';return;}const s=await db.ref('users').orderByChild('nick').equalTo(n).once('value');const u=s.val();if(!u){e.textContent='Не найден';return;}const id=Object.keys(u)[0];if(u[id].pass!==p){e.textContent='Неверный пароль';return;}myId=id;myNick=n;localStorage.setItem('gb_id',myId);localStorage.setItem('gb_nick',myNick);loadSettings();updateOnline(true);closeModal('authModal');showApp();listenForCalls();monitorOnlineUsers();});
        document.getElementById('regBtn').addEventListener('click',async()=>{const n=document.getElementById('authNick').value.trim(),p=document.getElementById('authPass').value.trim(),e=document.getElementById('authErr');if(!n||!p){e.textContent='Заполните';return;}if(n.length<2){e.textContent='Ник от 2';return;}const s=await db.ref('users').orderByChild('nick').equalTo(n).once('value');if(s.exists()){e.textContent='Занят';return;}const id=generateId();await db.ref('users/'+id).set({nick:n,pass:p,created:Date.now(),online:true,lastSeen:Date.now(),settings:userSettings,blocked:{}});myId=id;myNick=n;localStorage.setItem('gb_id',myId);localStorage.setItem('gb_nick',myNick);closeModal('authModal');showApp();listenForCalls();monitorOnlineUsers();});

        function showApp(){document.getElementById('myIdDisplay').textContent=myId;updateFooterAvatar();document.getElementById('footerName').textContent=myNick;if(isAdmin()){document.getElementById('adminBtn').style.display='inline-block';document.getElementById('adminBtn').onclick=showAdminPanel;}loadChats();applyAllSettings();}
        function updateFooterAvatar(){const av=document.getElementById('footerAvatar');if(userSettings.avatar){av.innerHTML=`<img src="${userSettings.avatar}" alt="${myNick}">`;av.style.background='none';}else{av.textContent=myNick[0].toUpperCase();av.style.background='linear-gradient(135deg, var(--accent), #ec4899)';}}

        // АДМИН
        async function showAdminPanel(){if(!isAdmin())return;showModal('adminModal');const users=db.cache?.users||{};const total=Object.keys(users).length;const online=Object.values(users).filter(u=>u.online).length;document.getElementById('adminStats').innerHTML=`<p><b>👥 Всего:</b> ${total}</p><p><b>🟢 Онлайн:</b> ${online}</p><p><b>⚫ Оффлайн:</b> ${total-online}</p><hr>${Object.entries(users).map(([id,u])=>`<div style="font-size:11px;padding:4px 0;">${u.online?'🟢':'⚫'} ${esc(u.nick||'???')}</div>`).join('')}`;}
        document.getElementById('closeAdmin').addEventListener('click',()=>closeModal('adminModal'));

        // ПОИСК
        document.getElementById('searchBtn').addEventListener('click',()=>{showModal('searchModal');document.getElementById('searchResults').innerHTML='';});
        document.getElementById('closeSearch').addEventListener('click',()=>closeModal('searchModal'));
        function searchUsers(){const q=document.getElementById('searchInput').value.trim().toLowerCase(),c=document.getElementById('searchResults');if(!q){c.innerHTML='<div style="color:var(--text2);padding:15px;">Введите ник</div>';return;}const users=db.cache?.users||{};const r=[];for(const id in users){if(id!==myId&&users[id].nick.toLowerCase().includes(q))r.push({id,nick:users[id].nick,lastSeen:users[id].lastSeen,avatar:users[id].avatar});}c.innerHTML=r.length?r.map(x=>`<div class="user-list-item" onclick="startChat('${x.id}')"><div class="avatar" style="width:36px;height:36px;font-size:14px;">${x.avatar?`<img src="${x.avatar}" alt="">`:x.nick[0].toUpperCase()}</div><div><span style="font-weight:600;">${esc(x.nick)}</span><br><small style="color:var(--text2);">${x.lastSeen?timeAgo(x.lastSeen):'давно'}</small></div></div>`).join(''):'<div style="color:var(--text2);padding:15px;">Никого нет</div>';}
        async function startChat(fid){const cid=[myId,fid].sort().join('_');const s=await db.ref('chats/'+cid).once('value');if(!s.exists())await db.ref('chats/'+cid).set({type:'chat',participants:[myId,fid],created:Date.now(),unread:{}});closeModal('searchModal');switchTab('chats');loadChats();openChat(cid,'chat');}

        // ГРУППЫ
        document.getElementById('groupBtn').addEventListener('click',()=>{showModal('groupModal');document.getElementById('groupName').value='';document.getElementById('groupDesc').value='';const users=db.cache?.users||{};const c=document.getElementById('groupMembers');c.innerHTML='';for(const id in users){if(id!==myId)c.innerHTML+=`<div class="user-list-item" data-uid="${id}" onclick="this.classList.toggle('selected')"><div class="avatar" style="width:36px;height:36px;font-size:14px;">${users[id].avatar?`<img src="${users[id].avatar}" alt="">`:users[id].nick[0].toUpperCase()}</div><span>${esc(users[id].nick)}</span></div>`;}});
        document.getElementById('closeGroup').addEventListener('click',()=>closeModal('groupModal'));
        document.getElementById('createGroup').addEventListener('click',async()=>{const name=document.getElementById('groupName').value.trim()||'Группа',desc=document.getElementById('groupDesc').value.trim();const sel=[...document.querySelectorAll('#groupMembers .user-list-item.selected')].map(el=>el.dataset.uid);if(!sel.length)return alert('Выберите');sel.push(myId);const gid='group_'+Date.now();await db.ref('chats/'+gid).set({type:'group',name,description:desc,participants:sel,created:Date.now(),owner:myId,admins:{[myId]:true},inviteLink:gid,pinnedMsg:null,unread:{},actionLog:{}});closeModal('groupModal');switchTab('groups');loadChats();});

        // ДЕЙСТВИЯ ГРУППЫ
        async function showGroupActions(){if(!activeChatId||activeChatType!=='group')return;const cs=await db.ref('chats/'+activeChatId).once('value'),chat=cs.val();const isOwner=chat.owner===myId;const isAdmin=chat.admins?.[myId];const users=db.cache?.users||{};let html='<p><b>Участники:</b></p>';for(const pid of chat.participants){const u=users[pid]||{};html+=`<p>${esc(u.nick||pid)} ${chat.owner===pid?'👑':chat.admins?.[pid]?'⭐':''} ${(isOwner||isAdmin)&&pid!==myId?`<button onclick="kickUser('${pid}')" style="background:var(--red);color:#fff;border:none;padding:4px 8px;border-radius:4px;cursor:pointer;margin-left:8px;">Кик</button>`:''}</p>`;}if(isOwner||isAdmin){html+='<hr><p onclick="closeModal(\'groupActionsModal\')" style="color:var(--text2);">Закрыть</p>';}document.getElementById('groupActionsList').innerHTML=html;showModal('groupActionsModal');}
        async function kickUser(pid){if(!confirm('Кикнуть участника?'))return;const cs=await db.ref('chats/'+activeChatId).once('value'),chat=cs.val();chat.participants=chat.participants.filter(p=>p!==pid);chat.actionLog=chat.actionLog||{};chat.actionLog[Date.now()]={action:'kick',user:pid,by:myId};await db.ref('chats/'+activeChatId).update({participants:chat.participants,actionLog:chat.actionLog});closeModal('groupActionsModal');loadChats();if(activeChatId)renderMessages();}
        document.getElementById('groupActionsBtn').addEventListener('click',showGroupActions);
        document.getElementById('closeGroupActions').addEventListener('click',()=>closeModal('groupActionsModal'));

        function switchTab(t){currentTab=t;document.getElementById('tabChats').classList.toggle('active',t==='chats');document.getElementById('tabGroups').classList.toggle('active',t==='groups');loadChats();}
        function loadChats(){const users=db.cache?.users||{};const chats=db.cache?.chats||{};let items=[];for(const id in chats){const c=chats[id];if(!c.participants.includes(myId))continue;if(currentTab==='chats'&&c.type==='group')continue;if(currentTab==='groups'&&c.type!=='group')continue;const msgs=db.cache?.messages?.[id]||{};const last=Object.values(msgs).pop()||null;const unread=(c.unread||{})[myId]||0;items.push({id,chat:c,last,unread});}
