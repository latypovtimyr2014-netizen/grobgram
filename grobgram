        // СООБЩЕНИЯ
        async function renderMessages(){if(!activeChatId)return;const ms=await db.ref('messages/'+activeChatId).once('value'),msgs=ms.val()||{};if(!db.cache.messages)db.cache.messages={};db.cache.messages[activeChatId]=msgs;const chat=db.cache?.chats?.[activeChatId]||{};const users=db.cache?.users||{};const container=document.getElementById('messagesContainer');container.innerHTML='';if(chat.pinnedMsg){container.innerHTML+=`<div class="pinned-msg">📌 ${esc(chat.pinnedMsg.text?.substring(0,30)||chat.pinnedMsg.sticker||'')} <button onclick="unpinMsg()" style="background:none;border:none;color:var(--text);cursor:pointer;">✕</button></div>`;}
        for(const mid in msgs){const m=msgs[mid];if(m.poll){container.innerHTML+=renderPoll(m,mid);continue;}const isMine=m.from===myId;const sender=users[m.from]||{nick:'???'};const reactions=m.reactions||{};let content='';if(m.voice){content=`<div class="voice-msg"><span>🎤</span><audio controls src="${m.voice}"></audio></div>`;}else if(m.image){content=`<img src="${m.image}" onclick="window.open('${m.image}')">`;}else if(m.sticker){content=`<span style="font-size:48px;">${m.sticker}</span>`;}else if(m.surprise){content=`<span class="surprise-msg" onclick="this.classList.toggle('revealed')">${esc(m.text||'')}</span>`;}else if(m.drawing){content=`<img src="${m.drawing}" style="max-width:200px;border:2px dashed var(--accent);border-radius:8px;">`;}else{let txt=esc(m.text||'');txt=txt.replace(/\*\*(.+?)\*\*/g,'<b>$1</b>').replace(/\*(.+?)\*/g,'<i>$1</i>').replace(/~~(.+?)~~/g,'<s>$1</s>').replace(/`(.+?)`/g,'<code>$1</code>');txt=txt.replace(/(https?:\/\/[^\s]+)/g,'<a href="$1" target="_blank" style="color:var(--accent-light);">$1</a>');txt=txt.replace(/@(\w+)/g,'<span class="mention">@$1</span>');content=txt;}
