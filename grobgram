<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GrobGram • Мессенджер</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <style>
        :root {
            --bg: #08080f; --surface: #10101a; --surface2: #181825; --card: #1c1c2e; --hover: #222235;
            --accent: #7c3aed; --accent-light: #a78bfa; --text: #e9e8f0; --text2: #8e8da0;
            --border: #1f1f35; --border-light: #2a2a42; --online: #22c55e; --bubble-mine: #7c3aed;
            --bubble-other: #1a1a2e; --red: #ef4444; --radius: 14px; --shadow: 0 20px 50px rgba(0,0,0,0.4);
        }
        .light-theme {
            --bg: #f5f5f7; --surface: #ffffff; --surface2: #f0f0f5; --card: #eaeaef; --hover: #e0e0e8;
            --text: #1a1a2e; --text2: #6b6b80; --border: #d5d5e0; --bubble-other: #ffffff;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        html,body { width:100%; height:100%; overflow:hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', Roboto, sans-serif; background:var(--bg); color:var(--text); letter-spacing: -0.15px; }
        .bg-orb { position:fixed; border-radius:50%; filter:blur(130px); pointer-events:none; z-index:0; animation:orbFloat 16s ease-in-out infinite; opacity:0.6; }
        .bg-orb.o1 { width:550px; height:550px; background:radial-gradient(circle, rgba(124,58,237,0.4), transparent); top:-200px; left:-120px; }
        .bg-orb.o2 { width:450px; height:450px; background:radial-gradient(circle, rgba(99,102,241,0.3), transparent); bottom:-150px; right:-80px; animation-delay:-8s; }
        @keyframes orbFloat { 0%,100%{ transform:translate(0,0) scale(1); } 50%{ transform:translate(35px,-35px) scale(1.12); } }
        .app { display:flex; width:100%; height:100vh; position:relative; z-index:1; background:var(--surface); overflow:hidden; }
        @media(min-width:900px){ .app { border-radius:18px; margin:12px; height:calc(100vh - 24px); box-shadow:var(--shadow); border:1px solid var(--border); } }
        .sidebar { width:370px; min-width:370px; border-right:1px solid var(--border); display:flex; flex-direction:column; height:100%; background:var(--surface2); }
        .sidebar-header { padding:18px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:10px; }
        .logo { font-size:21px; font-weight:800; background:linear-gradient(135deg, var(--accent-light), var(--accent)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; display:flex; align-items:center; gap:10px; }
        .logo-dot { width:34px; height:34px; background:linear-gradient(135deg, var(--accent), #6366f1); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:15px; color:#fff; -webkit-text-fill-color:#fff; box-shadow:0 6px 18px rgba(124,58,237,0.4); }
        .id-card { background:var(--card); border:1px solid var(--border-light); border-radius:var(--radius-sm); padding:10px 16px; margin:10px 14px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
        .id-label { font-size:10px; color:var(--text2); text-transform:uppercase; letter-spacing:0.5px; }
        .id-value { font-size:13px; color:var(--accent-light); font-family:'SF Mono','Fira Code',monospace; }
        .copy-btn { background:var(--accent); color:#fff; border:none; padding:7px 12px; border-radius:8px; cursor:pointer; font-size:11px; }
        .tabs { display:flex; padding:6px 12px; gap:5px; }
        .tab-btn { flex:1; padding:9px; border-radius:20px; border:1px solid transparent; background:transparent; color:var(--text2); font-size:11px; cursor:pointer; text-align:center; font-weight:600; transition:0.2s; }
        .tab-btn.active { background:var(--accent); color:#fff; border-color:var(--accent); }
        .search-box { padding:6px 12px; }
        .search-box input { width:100%; padding:10px 16px; background:var(--card); border:1px solid var(--border); border-radius:20px; color:var(--text); font-size:13px; outline:none; }
        .chat-list { flex:1; overflow-y:auto; padding:2px 8px; }
        .chat-list::-webkit-scrollbar { width:3px; } .chat-list::-webkit-scrollbar-thumb { background:var(--border-light); }
        .chat-item { display:flex; align-items:center; gap:12px; padding:12px 14px; border-radius:var(--radius); cursor:pointer; transition:0.2s; margin:1px 0; position:relative; }
        .chat-item:hover { background:var(--hover); }
        .chat-item.active { background:rgba(124,58,237,0.08); border-left:3px solid var(--accent); }
        .unread-count { position:absolute; right:10px; top:8px; background:var(--accent); color:#fff; font-size:10px; min-width:18px; height:18px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-weight:700; }
        .avatar { width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:18px; color:#fff; flex-shrink:0; background:linear-gradient(135deg, var(--accent), #6366f1); position:relative; overflow:hidden; }
        .avatar img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
        .avatar.online::after { content:''; position:absolute; bottom:1px; right:1px; width:12px; height:12px; background:var(--online); border-radius:50%; border:3px solid var(--surface2); }
        .chat-info { flex:1; min-width:0; } .chat-name { font-weight:700; font-size:14px; } .chat-last { font-size:12px; color:var(--text2); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .sidebar-footer { padding:12px 16px; border-top:1px solid var(--border); display:flex; align-items:center; gap:10px; background:var(--card); }
        .user-avatar { width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px; color:#fff; background:linear-gradient(135deg, var(--accent), #ec4899); overflow:hidden; }
        .user-avatar img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
        .user-name { font-weight:700; font-size:13px; flex:1; }
        .dnd-badge { background:var(--red); color:#fff; font-size:9px; padding:2px 6px; border-radius:8px; margin-right:4px; }
        .btn-icon { width:32px; height:32px; border-radius:50%; border:1px solid var(--border); background:transparent; color:var(--text2); cursor:pointer; font-size:12px; display:flex; align-items:center; justify-content:center; transition:0.2s; }
        .btn-icon:hover { background:var(--accent); color:#fff; border-color:var(--accent); }
        .chat-area { flex:1; display:flex; flex-direction:column; background:var(--bg); }
        .chat-header { padding:14px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:12px; background:var(--surface2); }
        .chat-header .avatar { width:40px; height:40px; font-size:16px; }
        .chat-header-name { font-weight:700; font-size:15px; flex:1; }
        .last-seen { font-size:10px; color:var(--text2); }
        .messages { flex:1; overflow-y:auto; padding:18px 22px; display:flex; flex-direction:column; gap:4px; background:var(--bg); }
        .pinned-msg { background:rgba(124,58,237,0.1); border:1px solid var(--accent); border-radius:8px; padding:8px 12px; margin-bottom:8px; font-size:12px; display:flex; justify-content:space-between; }
        .poll-box { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:12px; margin:4px 0; max-width:300px; }
        .poll-option { padding:8px 12px; margin:4px 0; background:var(--hover); border-radius:8px; cursor:pointer; display:flex; justify-content:space-between; }
        .poll-bar { height:4px; background:var(--accent); border-radius:2px; margin-top:4px; }
        .reply-preview { background:var(--card); border-left:3px solid var(--accent); border-radius:6px; padding:6px 10px; margin-bottom:4px; font-size:12px; color:var(--text2); }
        .msg-row { display:flex; gap:8px; max-width:68%; animation:pop 0.3s ease; position:relative; }
        .msg-row:hover .msg-actions { display:flex; }
        @keyframes pop { from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);} }
        .msg-row.mine { align-self:flex-end; flex-direction:row-reverse; }
        .msg-avatar { width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:10px; color:#fff; background:linear-gradient(135deg, var(--accent), #6366f1); overflow:hidden; }
        .msg-avatar img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
        .msg-bubble { padding:10px 14px; border-radius:16px; font-size:14px; }
        .msg-row.mine .msg-bubble { background:var(--bubble-mine); color:#fff; border-bottom-right-radius:6px; }
        .msg-row.other .msg-bubble { background:var(--bubble-other); border:1px solid var(--border-light); border-bottom-left-radius:6px; }
        .msg-bubble img { max-width:220px; max-height:220px; border-radius:10px; cursor:pointer; }
        .msg-bubble b { font-weight:700; } .msg-bubble i { font-style:italic; } .msg-bubble s { text-decoration:line-through; } .msg-bubble code { background:rgba(0,0,0,0.3); padding:2px 6px; border-radius:4px; font-family:monospace; font-size:13px; }
        .mention { color:var(--accent-light); font-weight:700; }
        .msg-reactions { display:flex; gap:3px; margin-top:3px; }
        .msg-reaction { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:2px 6px; font-size:11px; cursor:pointer; }
        .msg-actions { display:none; position:absolute; top:-22px; right:0; gap:3px; z-index:10; }
        .msg-actions button { background:var(--card); border:1px solid var(--border-light); color:var(--text); font-size:10px; padding:3px 7px; border-radius:6px; cursor:pointer; }
        .voice-msg { display:flex; align-items:center; gap:6px; } .voice-msg audio { height:32px; width:130px; }
        .surprise-msg { filter:blur(8px); cursor:pointer; } .surprise-msg.revealed { filter:blur(0); }
        .input-bar { padding:12px 18px; border-top:1px solid var(--border); display:flex; gap:10px; align-items:center; background:var(--surface2); position:relative; }
        .input-bar input { flex:1; padding:11px 18px; background:var(--card); border:1px solid var(--border); border-radius:22px; color:var(--text); font-size:14px; outline:none; }
        .btn-send { width:40px; height:40px; border-radius:50%; border:none; background:linear-gradient(135deg, var(--accent), #6366f1); color:#fff; font-size:15px; cursor:pointer; }
        .btn-call { width:40px; height:40px; border-radius:50%; border:1px solid var(--border); background:var(--card); color:var(--online); font-size:15px; cursor:pointer; display:flex; align-items:center; justify-content:center; margin-right:4px; }
        .btn-attach,.btn-voice { width:40px; height:40px; border-radius:50%; border:1px solid var(--border); background:var(--card); color:var(--text2); font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
        .btn-voice.recording { background:var(--red); color:#fff; animation:pulse 1s infinite; }
        .replying-bar { background:var(--accent); color:#fff; padding:6px 14px; font-size:12px; display:none; align-items:center; justify-content:space-between; }
        .replying-bar button { background:none; border:none; color:#fff; cursor:pointer; }
        @keyframes pulse { 0%,100%{ box-shadow:0 0 0 0 rgba(239,68,68,0.5); } 50%{ box-shadow:0 0 0 12px rgba(239,68,68,0); } }
        .recording-timer { font-size:12px; color:var(--red); font-weight:700; min-width:40px; text-align:center; }
        .empty { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; color:var(--text2); }
        .empty-icon { font-size:70px; opacity:0.2; }
        .empty h3 { font-size:20px; font-weight:800; background:linear-gradient(135deg, var(--accent-light), var(--accent)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        .modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(4,4,12,0.85); z-index:100; justify-content:center; align-items:center; backdrop-filter:blur(12px); }
        .modal.active { display:flex !important; }
        .modal-box { background:var(--surface); padding:28px 24px; border-radius:18px; width:90%; max-width:420px; border:1px solid var(--border); box-shadow:var(--shadow); max-height:85vh; overflow-y:auto; text-align:center; }
        .modal-box h2 { font-size:20px; font-weight:800; margin-bottom:10px; background:linear-gradient(135deg, var(--accent-light), var(--accent)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
        .modal-input { width:100%; padding:12px 16px; margin:6px 0; background:var(--card); border:1px solid var(--border); border-radius:12px; color:var(--text); font-size:13px; outline:none; }
        .modal-btn { width:100%; padding:12px; margin:6px 0; border:none; border-radius:12px; font-size:14px; font-weight:700; cursor:pointer; }
        .modal-btn.primary { background:linear-gradient(135deg, var(--accent), #6366f1); color:#fff; }
        .modal-btn.secondary { background:var(--card); color:var(--text); border:1px solid var(--border); }
        .modal-btn.danger { background:rgba(239,68,68,0.08); color:var(--red); border:1px solid rgba(239,68,68,0.2); }
        .user-list-item { display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:10px; cursor:pointer; }
        .user-list-item:hover { background:var(--hover); }
        .user-list-item.selected { background:rgba(124,58,237,0.12); border:1px solid rgba(124,58,237,0.2); }
        .setting-row { display:flex; justify-content:space-between; align-items:center; padding:13px 0; border-bottom:1px solid var(--border); text-align:left; gap:10px; }
        .theme-dots { display:flex; gap:8px; } .theme-dot { width:26px; height:26px; border-radius:50%; cursor:pointer; border:2px solid transparent; }
        .theme-dot.active { border-color:#fff; }
        .call-window { display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:200; background:var(--surface); border-radius:20px; padding:30px; text-align:center; border:2px solid var(--accent); box-shadow:0 30px 60px rgba(0,0,0,0.7); min-width:300px; }
        .call-window video { width:250px; height:180px; border-radius:12px; background:#000; margin:10px 0; }
        .call-buttons { display:flex; gap:10px; justify-content:center; margin-top:15px; }
        .call-btn { width:50px; height:50px; border-radius:50%; border:none; font-size:20px; cursor:pointer; }
        .call-btn.accept { background:var(--online); color:#fff; } .call-btn.reject,.call-btn.end { background:var(--red); color:#fff; }
        .collectible-sticker { font-size:24px; cursor:pointer; margin:2px; padding:4px; border-radius:8px; }
        .admin-badge { background:gold; color:#000; font-size:9px; padding:2px 6px; border-radius:8px; margin-left:4px; font-weight:700; }
        .group-actions-modal { text-align:left; }
        .group-actions-modal p { padding:6px 0; cursor:pointer; border-radius:6px; padding:8px; }
        .group-actions-modal p:hover { background:var(--hover); }
        .link-preview { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:8px; margin-top:4px; font-size:12px; }
        .link-preview img { max-width:100%; border-radius:6px; margin-bottom:4px; }
        @media (max-width:768px) { .sidebar { width:100%; min-width:100%; position:fixed; z-index:50; } .sidebar.hidden { display:none; } .chat-area.hidden { display:none; } }
    </style>
</head>
<body>
    <div class="bg-orb o1"></div><div class="bg-orb o2"></div>

    <!-- ВХОД -->
    <div class="modal active" id="authModal"><div class="modal-box"><h2>💬 GrobGram</h2><input type="text" class="modal-input" id="authNick" placeholder="Никнейм"><input type="password" class="modal-input" id="authPass" placeholder="Пароль"><p style="color:var(--red);font-size:12px;" id="authErr"></p><button class="modal-btn primary" id="loginBtn">🔑 Войти</button><button class="modal-btn secondary" id="regBtn">✨ Регистрация</button></div></div>
    <!-- ПОИСК -->
    <div class="modal" id="searchModal"><div class="modal-box"><h2>🔍 Найти</h2><input type="text" class="modal-input" id="searchInput" placeholder="Ник..." oninput="searchUsers()"><div id="searchResults" style="max-height:200px;overflow-y:auto;"></div><button class="modal-btn secondary" id="closeSearch">Отмена</button></div></div>
    <!-- ГРУППА -->
    <div class="modal" id="groupModal"><div class="modal-box"><h2>👥 Группа</h2><input type="text" class="modal-input" id="groupName" placeholder="Название"><input type="text" class="modal-input" id="groupDesc" placeholder="Описание"><div id="groupMembers" style="max-height:150px;overflow-y:auto;"></div><button class="modal-btn primary" id="createGroup">Создать</button><button class="modal-btn secondary" id="closeGroup">Отмена</button></div></div>
    <!-- ОПРОС -->
    <div class="modal" id="pollModal"><div class="modal-box"><h2>📊 Опрос</h2><input type="text" class="modal-input" id="pollQuestion" placeholder="Вопрос"><input type="text" class="modal-input" id="pollOpt1" placeholder="Вариант 1"><input type="text" class="modal-input" id="pollOpt2" placeholder="Вариант 2"><input type="text" class="modal-input" id="pollOpt3" placeholder="Вариант 3"><button class="modal-btn primary" id="createPollBtn">Создать</button><button class="modal-btn secondary" id="closePoll">Отмена</button></div></div>
    <!-- ПЕРЕСЛАТЬ -->
    <div class="modal" id="forwardModal"><div class="modal-box"><h2>↪ Переслать</h2><div id="forwardList" style="max-height:200px;overflow-y:auto;"></div><button class="modal-btn secondary" id="closeForward">Отмена</button></div></div>
    <!-- ПОИСК СООБЩЕНИЙ -->
    <div class="modal" id="searchMsgModal"><div class="modal-box"><h2>🔍 Поиск</h2><input type="text" class="modal-input" id="searchMsgInput" placeholder="Текст..." oninput="searchMessages()"><div id="searchMsgResults" style="max-height:200px;overflow-y:auto;text-align:left;"></div><button class="modal-btn secondary" id="closeSearchMsg">Закрыть</button></div></div>
    <!-- СКРЫТЫЙ ЧАТ -->
    <div class="modal" id="lockChatModal"><div class="modal-box"><h2>🔒 Скрытый чат</h2><input type="password" class="modal-input" id="lockPass" placeholder="Пароль"><button class="modal-btn primary" id="setLockBtn">Установить</button><button class="modal-btn secondary" id="removeLockBtn">Убрать</button><button class="modal-btn secondary" id="closeLock">Отмена</button></div></div>
    <!-- QR -->
    <div class="modal" id="qrModal"><div class="modal-box"><h2>📱 QR-код</h2><div id="qrcode" style="display:flex;justify-content:center;margin:15px 0;"></div><button class="modal-btn secondary" id="closeQr">Закрыть</button></div></div>
    <!-- СТИКЕРЫ -->
    <div class="modal" id="stickerModal"><div class="modal-box"><h2>🎴 Стикеры</h2><div id="stickerList" style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;"></div><button class="modal-btn secondary" id="closeSticker">Закрыть</button></div></div>
    <!-- ОТЛОЖИТЬ -->
    <div class="modal" id="scheduleModal"><div class="modal-box"><h2>⏰ Отложить</h2><input type="datetime-local" class="modal-input" id="scheduleTime"><button class="modal-btn primary" id="scheduleSend">Запланировать</button><button class="modal-btn secondary" id="closeSchedule">Отмена</button></div></div>
    <!-- АДМИН -->
    <div class="modal" id="adminModal"><div class="modal-box"><h2>👑 Админ-панель</h2><div id="adminStats" style="text-align:left;"></div><button class="modal-btn secondary" id="closeAdmin">Закрыть</button></div></div>
    <!-- ДЕЙСТВИЯ ГРУППЫ -->
    <div class="modal" id="groupActionsModal"><div class="modal-box group-actions-modal"><h2>👥 Действия</h2><div id="groupActionsList"></div><button class="modal-btn secondary" id="closeGroupActions">Закрыть</button></div></div>
    <!-- НАСТРОЙКИ -->
    <div class="modal" id="settingsModal"><div class="modal-box"><h2>⚙️ Настройки</h2>
        <label class="avatar-upload" for="avatarFile" id="avatarPreview" style="width:75px;height:75px;border-radius:50%;margin:0 auto 14px;cursor:pointer;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--accent),#ec4899);overflow:hidden;"><span style="font-size:28px;font-weight:900;" id="avatarText"></span></label>
        <input type="file" id="avatarFile" accept="image/*" style="display:none;" onchange="uploadAvatar(event)">
        <input type="text" class="modal-input" id="settingsNick" placeholder="Никнейм"><input type="password" class="modal-input" id="settingsPass" placeholder="Новый пароль">
        <input type="text" class="modal-input" id="settingsBio" placeholder="О себе..."><input type="text" class="modal-input" id="settingsLink" placeholder="Ссылка">
        <input type="date" class="modal-input" id="settingsBday"><input type="text" class="modal-input" id="settingsSignature" placeholder="Подпись">
        <input type="text" class="modal-input" id="settingsNickColor" placeholder="Цвет ника (hex)">
        <input type="text" class="modal-input" id="settingsStatus" placeholder="Статус">
        <div class="setting-row"><span>🌓 Тёмная тема</span><button class="modal-btn secondary" style="width:auto;padding:6px 16px;" id="toggleThemeBtn">Переключить</button></div>
        <div class="setting-row"><span>🎨 Цвет</span><div class="theme-dots"><div class="theme-dot active" style="background:#7c3aed;" data-color="#7c3aed" onclick="setAccent('#7c3aed')"></div><div class="theme-dot" style="background:#3b82f6;" data-color="#3b82f6" onclick="setAccent('#3b82f6')"></div><div class="theme-dot" style="background:#ef4444;" data-color="#ef4444" onclick="setAccent('#ef4444')"></div><div class="theme-dot" style="background:#22c55e;" data-color="#22c55e" onclick="setAccent('#22c55e')"></div><div class="theme-dot" style="background:#f59e0b;" data-color="#f59e0b" onclick="setAccent('#f59e0b')"></div><div class="theme-dot" style="background:#ec4899;" data-color="#ec4899" onclick="setAccent('#ec4899')"></div><div class="theme-dot" style="background:#06b6d4;" data-color="#06b6d4" onclick="setAccent('#06b6d4')"></div></div></div>
